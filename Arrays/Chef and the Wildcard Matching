t = int(input())

for _ in range(t):
    x = input().strip()
    y = input().strip()

    possible = True

    for i in range(len(x)):

        if x[i] != '?' and y[i] != '?' and x[i] != y[i]:
            possible = False
            break

    if possible:
        print("Yes")
    else:
        print("No")
