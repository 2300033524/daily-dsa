t = int(input())

vowels = "aeiou"

for _ in range(t):
    s = input().strip()
    
    count = 0
    happy = False
    
    for ch in s:
        if ch in vowels:
            count += 1
            if count >= 3:
                happy = True
                break
        else:
            count = 0
    
    if happy:
        print("Happy")
    else:
        print("Sad")
